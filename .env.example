# ==========================================
# GOOGLE GEMINI API CONFIGURATION
# ==========================================
# Optional: used for AI-powered name, trait, portrait, and backstory generation.
# Get your API key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Optional: override the text-generation model.
# Default: gemini-2.5-flash
VITE_GEMINI_TEXT_MODEL=

# If you do not set a key, the app will still work; AI features will be disabled.

# ==========================================
# HOST OAUTH (LAN table session)
# ==========================================
# The preview server can inject this machine's Codex (~/.codex/auth.json)
# and Grok (~/.grok/auth.json) OAuth so players do not log in.
# Tokens never go into the JS bundle. Set to 1 to turn a provider off.
# CODEX_HOST_DISABLED=1
# XAI_HOST_DISABLED=1
# Optional. If set, /__host requires this key. If unset, private LAN IPs can open it.
# HOST_OAUTH_ADMIN_KEY=
